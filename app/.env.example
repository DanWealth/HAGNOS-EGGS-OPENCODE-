# Copy to .env (local only, never commit). Docker Compose reads these.
DATABASE_URL=postgres://hagnos:hagnos@db:5432/hagnos_eggs
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
ORDER_WINDOW_OVERRIDE=false
# Cloudflare R2 (dashboard: R2 -> Manage API tokens)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hagnos-eggs-photos
R2_PUBLIC_URL=
# Paystack (dashboard: Settings -> API Keys) - checkout charges immediately when buyer authorizes
PAYSTACK_SECRET_KEY=
# Merchant billing email for phone-only buyers (Paystack needs an email per charge;
# receipts land here tagged +orderNo, buyer gets studio/SMS/track receipts instead)
PAYSTACK_FALLBACK_EMAIL=
# Termii transactional SMS (sender ID and DND route must be enabled on your account)
SMS_API_KEY=
SMS_SENDER_ID=Hagnos
TERMII_BASE_URL=https://api.ng.termii.com
# Admin allowlist: emails that may use admin APIs/pages (comma-separated)
ADMIN_EMAILS=
# Gemini visuals (aistudio.google.com -> Get API key; billing needed for images)
GEMINI_API_KEY=
