# Copy to .env (local only, never commit). Docker Compose reads these.
DATABASE_URL=postgres://hagnos:hagnos@db:5432/hagnos_eggs
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
ORDER_WINDOW_OVERRIDE=false
# Cloudflare R2 (dashboard: R2 -> Manage API tokens)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hagnos-eggs-photos
R2_PUBLIC_URL=
# Paystack (dashboard: Settings -> API Keys) - needed for real money hold/capture
PAYSTACK_SECRET_KEY=
# Termii / Africa's Talking (needed for SMS/WhatsApp notices)
SMS_API_KEY=
